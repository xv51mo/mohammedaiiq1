<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>M8 AI Motion Studio</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#09090b;color:#fff;font-family:Arial,sans-serif;padding:25px}
main{max-width:700px;margin:45px auto;background:#151518;padding:25px;border:1px solid #303036;border-radius:20px}
h1{text-align:center}
p{color:#aaa;text-align:center}
textarea,input,button{width:100%;padding:14px;margin-top:14px;border-radius:10px;font-size:16px}
textarea,input{background:#09090b;color:white;border:1px solid #444}
button{background:white;color:black;border:0;font-weight:bold;cursor:pointer}
button:disabled{opacity:.5}
#status{white-space:pre-wrap;overflow-wrap:anywhere;text-align:right;line-height:1.8}
video{width:100%;margin-top:15px;border-radius:12px}
a{color:#9dc7ff}
</style>
</head>
<body>
<main>
<h1>M8 AI Motion Studio</h1>
<p>حوّل فكرتك إلى فيديو بالذكاء الاصطناعي</p>
<textarea id="prompt" rows="5" placeholder="اكتب وصف الفيديو بالتفصيل..."></textarea>
<label>مدة الفيديو بالثواني</label>
<input id="duration" type="number" min="5" max="15" value="5">
<button id="generate" onclick="generateVideo()">إنشاء الفيديو</button>
<div id="status">جاهز لاستقبال فكرتك.</div>
<div id="result"></div>
</main>
<script>
const API_URL="https://YOUR-SERVER.onrender.com/api/videos";

async function generateVideo(){
 const prompt=document.getElementById("prompt").value.trim();
 const duration=Number(document.getElementById("duration").value);
 const status=document.getElementById("status");
 const button=document.getElementById("generate");
 const result=document.getElementById("result");

 if(!prompt){status.textContent="اكتب وصف الفيديو أولاً.";return;}
 if(!Number.isFinite(duration)||duration<5||duration>15){
 status.textContent="اختر مدة بين 5 و15 ثانية.";return;
 }

 button.disabled=true;
 result.innerHTML="";
 status.textContent="جارٍ إرسال الطلب...";

 try{
 const response=await fetch(API_URL,{
 method:"POST",
 headers:{"Content-Type":"application/json"},
 body:JSON.stringify({prompt,duration})
 });

 const text=await response.text();
 let data;

 try{data=JSON.parse(text);}
 catch{
 throw new Error("الخادم أرسل HTML أو XML بدل JSON. تحقق من رابط API وإعدادات الخادم.");
 }

 if(!response.ok){
 throw new Error(data.error||data.message||"فشل طلب إنشاء الفيديو.");
 }

 if(data.video_url){
 showVideo(data.video_url);
 }else if(data.request_id||data.requestId){
 status.textContent="تم استلام الطلب، لكن الخادم يحتاج إلى متابعة حالة التوليد. معرّف الطلب: "+(data.request_id||data.requestId);
 }else{
 status.textContent="استجابة الخادم: "+JSON.stringify(data);
 }
 }catch(error){
 status.textContent="خطأ: "+error.message;
 }finally{
 button.disabled=false;
 }
}

function showVideo(url){
 const result=document.getElementById("result");
 const status=document.getElementById("status");
 const video=document.createElement("video");
 video.controls=true;
 video.playsInline=true;
 video.src=url;
 const link=document.createElement("a");
 link.href=url;
 link.target="_blank";
 link.rel="noopener";
 link.textContent="فتح الفيديو أو تنزيله";
 result.replaceChildren(video,link);
 status.textContent="تم إنشاء الفيديو بنجاح.";
}
</script>
</body>
</html>
